# Copy to .env and replace every placeholder. Never commit .env.

# PostgreSQL container
POSTGRES_USER=sre
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sre
POSTGRES_PORT=5432

# Backend (local development: the database is reached on localhost)
DATABASE_URL=postgresql+psycopg://sre:change-me@localhost:5432/sre
APP_ENV=development
LOG_LEVEL=INFO
# Shared secret for POST /api/v1/ingest/metrics (at least 16 characters)
INGEST_TOKEN=change-me

# Integration tests use a separate database, created by docker/postgres-init
TEST_DATABASE_URL=postgresql+psycopg://sre:change-me@localhost:5432/sre_test
