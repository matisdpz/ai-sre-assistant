# Copy to .env and replace every placeholder. Never commit .env.

# PostgreSQL container
POSTGRES_USER=sre
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sre
POSTGRES_PORT=5432

# Backend (local development: the database is reached on localhost)
DATABASE_URL=postgresql+psycopg://sre:change-me@localhost:5432/sre
APP_ENV=development
LOG_LEVEL=INFO
# Shared secret for POST /api/v1/ingest/metrics (at least 16 characters)
INGEST_TOKEN=change-me

# Integration tests use a separate database, created by docker/postgres-init
TEST_DATABASE_URL=postgresql+psycopg://sre:change-me@localhost:5432/sre_test

# Optional AI diagnosis (Milestone 6). Leave empty to disable it: everything else works.
# Bring your own key from Google AI Studio; free tier quotas and terms are set by Google.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
